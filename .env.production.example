# Utility WhatsApp review-request template.
# {{1}} customer name, {{2}} business name, {{3}} ReviewRequest token.
# Body link: https://growwmatics.com/review/{{3}}?src=wa
# ?src=wa is not part of the token. {{3}} is never the Place ID.
# When this is set, new review sends use it. Leave it unset to keep the
# legacy marketing template (TWILIO_TEMPLATE_REVIEW_REQUEST, {{3}} = Place ID).
# Do not replace TWILIO_TEMPLATE_REVIEW_REQUEST. The SID below is not applied
# until this variable is set in the running environment.
TWILIO_TEMPLATE_REVIEW_REQUEST_UTILITY=HX5ac75bff43238d0c253a1dd15cca746c

# FR-5 profile execution and rollback. Disabled unless the value is exactly true.
# Google Posts, review replies, and photos do not read this flag.
# They stay on GBP_LIVE_WRITES_ENABLED. Leave this false until a controlled
# profile test is separately approved.
GBP_FR5_LIVE_WRITES_ENABLED=false

# ─── Native job worker (replaces Inngest, staged per function) ──────────────
# EVERYTHING below is OFF/empty by default. Inngest keeps running every
# function until a function id is listed in JOBS_NATIVE_FUNCTIONS. The web app
# (/api/inngest) and the worker must read identical values for these two.
# Runbook: docs/production-cutover.md   Rollback: docs/rollback-procedure.md
JOBS_NATIVE_ENABLED=
# Comma-separated Inngest function ids the native worker owns (never "*").
# Unknown ids make /api/inngest and the worker refuse to start.
JOBS_NATIVE_FUNCTIONS=
# Optional tuning (defaults shown). Collection name prefix:
# JOBS_COLLECTION_PREFIX=native_
# Max jobs executing at once in the single worker process (1-20):
# JOBS_CONCURRENCY=3
# Claim lease without heartbeat, heartbeat period, idle poll (ms):
# JOBS_LEASE_MS=60000
# JOBS_HEARTBEAT_MS=15000
# JOBS_POLL_MS=2000
# Graceful-shutdown drain before leftovers are released (must be < PM2 kill_timeout 40000):
# JOBS_SHUTDOWN_GRACE_MS=25000
# Missed cron slots older than this are skipped, not run late (ms):
# JOBS_CRON_CATCHUP_MS=3600000
# Cron leader-lock TTL and tolerated DB-vs-local clock skew (ms):
# JOBS_LEADER_TTL_MS=30000
# JOBS_MAX_CLOCK_SKEW_MS=30000
# Local health endpoint port (bound to 127.0.0.1):
# JOBS_HEALTH_PORT=3911

# Ownership guard: the worker verifies web released its ids via GET /api/inngest/ownership.
# Shared secret read by BOTH the web app and the worker; unset => endpoint 404 and
# the worker refuses to start. Generate a long random value; never commit it.
JOBS_GUARD_TOKEN=
# Worker-side URL of that endpoint (loopback default):
# JOBS_OWNERSHIP_URL=http://127.0.0.1:3000/api/inngest/ownership
# Local development only (ignored when NODE_ENV=production):
# JOBS_OWNERSHIP_GUARD=off

# STAGING/QA ONLY, never set in production. Suppresses every outbound send
# (WhatsApp Twilio+Meta, Expo push, email). Leave unset here.
# QA_SUPPRESS_OUTBOUND_SENDS=
