# ============================================================================
# PRODUCTION ENVIRONMENT CHECKLIST — GrowwMatics AI
# ============================================================================
# Copy to .env (or set in the host's env panel) and fill every REQUIRED value.
# Items marked [BREAKS CUSTOMERS] are the ones that fail visibly on day one.
# Generated 2026-07-07 from the pre-production audit.
# ============================================================================

# --- Core ---------------------------------------------------------------
# The PRODUCTION Atlas project's cluster (org owned by the GrowwMatics account,
# NOT the old shared intern cluster). Dedicated DB user with readWrite on the
# `growwmatics_prod` database ONLY — it must not be able to see dev/QA data.
# The URI's path segment selects the database:
#   mongodb+srv://<prod-user>:<pw>@<prod-cluster>/growwmatics_prod?retryWrites=true&w=majority
# IP allowlist on that project = the droplet's IP only. Atlas backups: ON.
# See documentation/deployment/atlas-migration-runbook (the migration plan).
MONGODB_URI=

# REQUIRED. Long random secret (e.g. `openssl rand -hex 48`). Signs all auth
# tokens AND is the bearer token for /api/automation/trigger — never reuse
# the dev value.
JWT_SECRET=
SESSION_SECRET=
NEXTAUTH_SECRET=
GOOGLE_TOKEN_SECRET=

# Bearer key the 4 /api/n8n/* routes require via the `x-api-key` header
# (src/middleware/apiKeyAuth.ts). Without it those routes 500.
AUTOMATION_API_KEY=

# --- Public URLs [BREAKS CUSTOMERS if left unset] -------------------------
# All three must be the real HTTPS domain. NEXT_PUBLIC_BASE_URL is used to
# build review-tracking links sent to customers over WhatsApp — if unset it
# falls back to http://localhost:3000 (src/services/inngest/functions.ts).
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_BASE_URL=https://yourdomain.com
NEXTAUTH_URL=https://yourdomain.com

# --- Google OAuth / GBP [BREAKS CUSTOMERS] --------------------------------
# 1. Add https://yourdomain.com/api/auth/google/callback as an authorized
#    redirect URI in Google Cloud Console.
# 2. Move the OAuth consent screen from "Testing" to "In production" —
#    in Testing mode every refresh token expires after 7 days, breaking all
#    customer GBP connections weekly. GBP scopes need Google verification;
#    start this early, it takes days-to-weeks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/google/callback
# Second Authorized redirect URI on the SAME OAuth client above (not a new
# client) — for the unauthenticated WhatsApp-first report-connect flow.
GOOGLE_REPORT_CONNECT_REDIRECT_URI=https://yourdomain.com/api/report-connect/callback
GOOGLE_MAPS_API_KEY=

# --- WhatsApp: Twilio (current setup) / Meta Cloud API [BREAKS CUSTOMERS] --
# GrowwMatics currently runs on a real, verified Twilio WhatsApp sender
# (Content Template Builder for approved templates) — WHATSAPP_PROVIDER=twilio
# forces that path regardless of the Meta keys below. The Meta direct-API
# path still exists as an alternative (sends auto-fall-back to Twilio while
# the two starred keys are empty) but isn't the active setup.
WHATSAPP_PROVIDER=twilio
META_WHATSAPP_ACCESS_TOKEN=            # * permanent system-user token
META_WHATSAPP_PHONE_NUMBER_ID=         # *
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_APP_SECRET=                       # required to verify inbound webhooks
META_WEBHOOK_VERIFY_TOKEN=             # any random string; set same in Meta app
# Approved utility template for business-initiated messages outside the 24h
# window; must have exactly one {{1}} body variable. Needs Meta approval.
META_UTILITY_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=en
# META_GRAPH_API_VERSION=v23.0

# Twilio — the real GrowwMatics WhatsApp sender (a purchased number, not the
# sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
# GrowwMatics-owned WhatsApp number (digits only). NEXT_PUBLIC_* powers the
# website "Book a Demo" wa.me link; PLATFORM_* lets the webhook route inbound to
# the sales/booking agents (matched via META_WHATSAPP_PHONE_NUMBER_ID on Meta).
NEXT_PUBLIC_WHATSAPP_NUMBER=
PLATFORM_WHATSAPP_NUMBER=

# Twilio Messaging Service (Console → Messaging → Services) with the WhatsApp
# sender above added to its Sender Pool. Optional but strongly recommended:
# Content Template sends via a raw `from` number hit error 63027 ("template
# does not exist for a language and locale") consistently in testing —
# routing through a Messaging Service is Twilio's own fix for that. Starts
# with "MG...". Leave empty to keep sending via the raw number (current
# behavior, known to hit 63027 on template sends).
TWILIO_MESSAGING_SERVICE_SID=

# Twilio Content Template SIDs, approved on the GrowwMatics WABA above
# (Twilio Console → Content Template Builder). Required for any
# business-initiated WhatsApp send — see src/lib/whatsappTemplates.ts for
# what each is used for and its variable order.
TWILIO_TEMPLATE_SALES_INTRO=
TWILIO_TEMPLATE_REPORT_READY=
TWILIO_TEMPLATE_REVIEW_REQUEST=
TWILIO_TEMPLATE_NOTIFICATION=
# Phase 7 — post-payment sequence (services/billing/customerActivation.ts).
# Left empty means those two WhatsApp messages are skipped gracefully (same
# fallback pattern as every other WA_TEMPLATES.* entry) until approved.
TWILIO_TEMPLATE_INVOICE_READY=
TWILIO_TEMPLATE_WELCOME_CUSTOMER=

# --- Background jobs: Inngest Cloud [BREAKS CUSTOMERS] --------------------
# Do NOT set INNGEST_DEV in production. Create an Inngest Cloud app and use
# its real keys; reminders, scheduled posts and GBP sync all run through it.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Email ----------------------------------------------------------------
# Resend: verify your domain, then set a from-address on it. The default
# fallback (onboarding@resend.dev) only delivers to the account owner.
RESEND_API_KEY=
RESEND_FROM_EMAIL="GrowwMatics AI <noreply@yourdomain.com>"
# SendGrid powers review-request emails; without it they are silently mocked.
SENDGRID_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=GrowwMatics AI

# --- Billing: Razorpay LIVE mode ------------------------------------------
# Use live keys (rzp_live_...). Configure the webhook in the Razorpay
# dashboard to POST https://yourdomain.com/api/webhook/razorpay with the
# same secret. The single sellable plan is managed by the super admin
# (Admin → Subscriptions); its Razorpay Plan is created automatically for
# the configured price. RAZORPAY_PLAN_ID_PRO is only a legacy fallback used
# until the super admin saves the plan once — safe to leave empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID_PRO=

# --- AI / data providers ----------------------------------------------------
GROQ_API_KEY=
OPENAI_API_KEY=
SERPAPI_KEY=
REVIEW_PROVIDER=serpapi
MAX_REVIEWS_PER_AUDIT=50
# Geo-grid keyword ranking + local-pack competitors (replaces SerpApi for this feature only —
# reviews above still use SerpApi). Get login/password from https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Thumbnail image generation. Two accepted key types (auto-routed by prefix):
#   nb_…        -> NanoBanana API (nananobanana.com), returns a hosted URL
#   AQ.… / AIzaSy… -> Google AI Studio / Gemini image model ("Nano Banana")
# EITHER WAY image generation is PAID: a NanoBanana plan, or a Google project
# with BILLING ENABLED (the free tier returns 429 / no image quota).
NANOBANANA_API_KEY=
# Optional override of the Gemini image model (default: gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Safety flags — keep these exact values in production -------------------
# true would skip plan-limit gating on audits.
AUDIT_BYPASS_MODE=false
# Master switch for writing to REAL Google Business Profiles (posts + review
# replies). Keep false until verified on a test account. See src/lib/gbpSafety.ts.
GBP_LIVE_WRITES_ENABLED=false
# Master switch for the Lead ownership/stage engine actually gating real
# WhatsApp sends. As of the Phase 5 outbound orchestrator
# (services/orchestration/outboundOrchestrator.ts), setting this true is NOT
# by itself enough to change any lead's behavior — a lead must ALSO be in
# the rollout cohort (OrchestrationConfig's leadIdAllowlist or
# rolloutPercentage; see that model's doc comment for how to add leads to
# it). A lead outside the cohort behaves byte-for-byte like this flag is
# false, regardless of its value. Keep false globally until the cohort
# mechanism itself has been exercised on a handful of real leads.
LEAD_ENGINE_V2=false
# Optional override for the outbound orchestrator's proactive-message
# cooldown window (hours) — how long after one agent-initiated message a
# lead must NOT receive another. If unset, falls back to
# OrchestrationConfig's cooldownHours doc field, then to a 4-hour default
# hardcoded in outboundOrchestrator.ts. Only applies to leads already gated
# on by LEAD_ENGINE_V2 + cohort above.
# ORCHESTRATOR_COOLDOWN_HOURS=4
# Phase 8's human-handoff "stuck hot lead" thresholds (leadScore >= X with
# no stage progression after Y nurture cycles) are config-doc fields, not
# env vars — see OrchestrationConfig.stuckLeadScoreThreshold/
# stuckNurtureCyclesThreshold (defaults 76/3). Edit the same way the cohort
# allowlist is edited today (direct DB write) until an admin UI exists.
# NODE_ENV=production is what disables the dev auth bypass in several API
# routes and the dev OTP console logging — make sure the host builds with it
# (next build / next start do this automatically).

# --- DigitalOcean Spaces (media storage for GBP logo/cover/photos) ---
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=blr1
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_CDN=

# --- Google Calendar (WhatsApp demo booking — Phase 6) ---------------------
# First-ever calendar integration in this codebase. Uses a Google Cloud
# service account (NOT the per-user OAuth pattern used for GBP elsewhere) —
# the demo calendar belongs to GrowwMatics itself, not any one signed-in
# user. See src/services/calendar/googleCalendar.ts for setup instructions
# (create a service account, enable the Calendar API, share the target
# calendar with the service account's email with "Make changes to events").
# Full service-account JSON key as a single-line string.
GOOGLE_CALENDAR_CREDENTIALS_JSON=
# The calendar ID to book demos on — a dedicated GrowwMatics calendar's ID,
# NOT a personal "primary" calendar.
GOOGLE_CALENDAR_ID=
