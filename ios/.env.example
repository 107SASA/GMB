# Base URL of the existing GrowwMatics Next.js backend (no trailing slash).
# The iOS Simulator shares the Mac's network, so localhost works there:
#   EXPO_PUBLIC_API_URL=http://localhost:3000
# A physical iPhone can't reach localhost — use your Mac's LAN IP or a tunnel:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
#   EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok-free.app
EXPO_PUBLIC_API_URL=http://localhost:3000

# The GrowwMatics-owned WhatsApp number (digits only, e.g. 919876543210) —
# same number as the web app's NEXT_PUBLIC_WHATSAPP_NUMBER. Used by the
# header's Help button to open a wa.me chat.
EXPO_PUBLIC_WHATSAPP_NUMBER=
