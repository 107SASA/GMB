# react-native@0.86.0 peerOptionally pins @react-native/jest-preset to exactly
# 0.86.0, while jest-expo@57.0.3 requires >=0.86.2 — no single version can
# satisfy both (upstream mismatch between their own peer-dependency metadata).
# It's a devDependency-only conflict (Jest tooling, never touches the shipped
# app bundle), so legacy-peer-deps is safe here. Without this, EAS Build's
# `npm ci` fails with ERESOLVE on every build.
legacy-peer-deps=true
