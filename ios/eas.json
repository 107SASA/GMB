{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:3000",
        "EXPO_PUBLIC_WHATSAPP_NUMBER": "919405070323"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://growwmatics.com",
        "EXPO_PUBLIC_WHATSAPP_NUMBER": "919405070323"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://growwmatics.com",
        "EXPO_PUBLIC_WHATSAPP_NUMBER": "919405070323"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
