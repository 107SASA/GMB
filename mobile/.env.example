# Base URL of the Next.js backend (no trailing slash).
# For local dev this must be reachable FROM THE DEVICE — localhost won't work
# from a physical phone. Use your machine's LAN IP or a tunnel:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:3000
#   EXPO_PUBLIC_API_URL=https://your-tunnel.ngrok-free.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Optional — crash/error reporting. Leave unset to keep Sentry a no-op; once
# a Sentry project exists, set this (Project Settings → Client Keys (DSN))
# and error reporting turns on with no other code changes.
# EXPO_PUBLIC_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>

